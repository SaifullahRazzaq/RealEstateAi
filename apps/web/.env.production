# Production build config for the web app. Tracked in git on purpose: the only
# value here is the API's public origin, which NEXT_PUBLIC_ inlines into the
# browser bundle anyway. Never add a secret to this file.
#
# Read at build time, not runtime — changing it needs a redeploy. A real
# environment variable of the same name (set in Vercel's dashboard) wins over
# this file, so per-environment overrides still work.
NEXT_PUBLIC_API_URL=https://real-estate-ai-api-gamma.vercel.app
