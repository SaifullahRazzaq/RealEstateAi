# ---------------------------------------------------------------------------
# Web (Vercel) — the only variable the frontend needs.
# ---------------------------------------------------------------------------

# Absolute origin of the Express API, no trailing slash.
# NEXT_PUBLIC_ means it is inlined into the browser bundle, so it must never
# hold a secret — it is only a URL.
#
# In production this MUST be https:// — a Vercel page served over HTTPS cannot
# call an http:// backend; the browser blocks it as mixed content.
#
#   local:      http://localhost:4000
#   staging:    https://api-staging.yourdomain.com
#   production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---------------------------------------------------------------------------
# Country code used to expand locally-written phone numbers for WhatsApp.
# ---------------------------------------------------------------------------
#
# WhatsApp addresses a chat by international number only, so "0300 1234567"
# never resolves — it has to become "923001234567". Numbers already stored with
# a leading + (or 00) are left alone; this only fills in the gap for the local
# ones. Digits only, no "+".
#
#   Pakistan: 92    UAE: 971    UK: 44    US/Canada: 1
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=92
