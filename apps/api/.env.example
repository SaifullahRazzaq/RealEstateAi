# ---------------------------------------------------------------------------
# API (VPS) — copy to .env and fill in. Never commit the filled-in file.
# ---------------------------------------------------------------------------

# development | production
NODE_ENV=development
# Free-form label shown on /health so you can tell staging from prod apart.
# development | staging | production
APP_ENV=development

# Local only. Railway/Render inject their own PORT and the app reads it.
# On Vercel it is meaningless — a function is invoked, not bound to a port.
PORT=4000

# MongoDB connection string
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/real-estate-crm

# Signing key for the bearer tokens this API issues.
# Generate with:  openssl rand -base64 32
# Use a DIFFERENT secret for staging and production.
JWT_SECRET=replace-me-with-a-long-random-string

# How long an issued token stays valid, in seconds. 86400 = 1 day.
TOKEN_TTL_SECONDS=86400

# Comma-separated browser origins allowed to call this API.
# MUST include the exact Vercel URL (scheme + host, no trailing slash).
#   local:      http://localhost:3000
#   staging:    https://crm-staging.vercel.app
#   production: https://crm.yourdomain.com
#
# An entry may use `*` as a wildcard for subdomain labels. Vercel gives every
# preview branch a fresh hostname, so listing them one by one is impossible:
#   CORS_ORIGINS=https://crm.yourdomain.com,https://*.vercel.app
# The wildcard only spans subdomains — https://*.vercel.app will never match
# https://evil.com or https://x.vercel.app.evil.com.
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# Google Calendar / Meet — OPTIONAL
# ---------------------------------------------------------------------------
# Without these, meetings still work: pick provider "manual" and paste a link,
# or "in_person". They are only needed to have the API generate real Meet links.
#
# A Google Meet URL cannot be invented — Google has to issue it. The only
# programmatic route is creating a Calendar event with a conference request,
# which is what these credentials unlock.
#
# Setup (console.cloud.google.com):
#   1. Create a project
#   2. APIs & Services -> Enable "Google Calendar API"
#   3. OAuth consent screen -> External -> add your testers' emails
#   4. Credentials -> Create OAuth client ID -> Web application
#   5. Authorised redirect URI must match GOOGLE_REDIRECT_URI exactly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# Where the API sends the browser after the Google consent screen.
WEB_APP_URL=http://localhost:3000
